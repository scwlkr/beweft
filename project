#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
case "${1:-help}" in
    help|--help|-h)
        printf '%s\n' \
            'Usage: ./project <command> [args...]' \
            '  setup DIRECTORY [PROJECT] [PORT] [--postgres-image LOCAL_IMAGE] [--worker-held]  Reserve an installation' \
            '  build DIRECTORY                    Build and pin a new installation image' \
            '  image DIRECTORY LOCAL_IMAGE        Pin an existing local image for a new installation' \
            '  compose DIRECTORY ARGS...          Run Docker Compose for an installation' \
            '  cli DIRECTORY ARGS...              Run the scoped CLI against the installation' \
            '  backup DIRECTORY NEW_BACKUP        Stop writes and create a consistent backup' \
            '  restore DIRECTORY BACKUP           Restore into a new, empty installation' \
            '  activate DIRECTORY --handover-reviewed  Enable a reconciled restored worker' \
            '  upgrade DIRECTORY IMAGE BACKUP     Back up and start a different local image' \
            '  release DIRECTORY                  Release an empty project reservation'
        printf '%s\n' \
            '  demo create DIRECTORY PROJECT PORT IMAGE  Create an isolated example installation' \
            '  demo resume DIRECTORY [--password-stdin]  Resume an interrupted example seed'
        exit 0 ;;
    demo)
        shift
        exec python3 "$root/scripts/demo.py" "$@" ;;
    setup|build|image|compose|cli|backup|restore|activate|upgrade|release)
        command=$1
        shift
        exec "$root/scripts/$command" "$@" ;;
esac
if ! command -v rustc >/dev/null 2>&1; then
    case "${1:-help}" in
        help|--help|-h)
            printf '%s\n' 'Usage: ./project <command> [args...]' 'Rust commands: tools/project-cli/main.rs. Install Rust to run them.'
            exit 0 ;;
    esac
    printf '%s\n' 'rustc unavailable. Install Rust or adapt ./project to an available runner.' >&2
    exit 127
fi
build=$(mktemp -d "${TMPDIR:-/tmp}/wstack-project.XXXXXX")
trap 'rm -rf "$build"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
rustc --edition=2021 "$root/tools/project-cli/main.rs" -o "$build/project"
"$build/project" "$@"
