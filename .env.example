# Reference only. scripts/setup generates a private installation directory.
COMPOSE_PROJECT_NAME=beweft
BEWEFT_IMAGE=beweft:local
BEWEFT_PORT=3000
BEWEFT_BIND_IP=127.0.0.1
BEWEFT_PUBLIC_URL=http://127.0.0.1:3000
BEWEFT_MAX_UPLOAD_BYTES=268435456
BEWEFT_MEDIA_QUOTA_BYTES=10737418240
# Unique values are generated by scripts/setup; never use this file as deployment credentials.
# BEWEFT_DB_PASSWORD, BEWEFT_SETUP_SECRET, BEWEFT_ENCRYPTION_KEY
